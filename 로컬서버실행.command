#!/bin/bash
cd "$(dirname "$0")"
echo "========================================"
echo "표지/내지 견적 및 주문생성기 로컬 서버"
echo "========================================"
echo "카카오 우편번호 API 등 웹 보안 정책이 필요한 기능들을"
echo "정상적으로 사용하기 위해 서버를 구동합니다."
echo ""
echo "서버 종료: 이 창을 닫거나 Ctrl+C를 누르세요."

# 포트 8080이 사용 중일 경우를 대비해 사용 중인 프로세스를 종료하거나 대체 포트를 쓸 수 있지만 기본 8080 사용
lsof -ti:8080 | xargs kill -9 2>/dev/null
sleep 1

# 브라우저 열기 (서버가 뜨는 시간을 살짝 기다림)
(sleep 2 && open "http://localhost:8080") &

# 파이썬 웹서버 실행
python3 -m http.server 8080
